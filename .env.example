# ---------------------------------------------------------------
# Wedding Yantra – VPS production env (copy to .env on the server)
# This file lives ONLY on the VPS; the deploy never overwrites it.
# ---------------------------------------------------------------

# Postgres (internal to the wedding-yantra-internal network)
POSTGRES_USER=wedding_yantra
# Must be URL-safe (it is embedded in DATABASE_URL). Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
POSTGRES_DB=wedding_yantra

# Comma-separated list of exact origins allowed to call the API.
# Include your Vercel production URL (<project-name>.vercel.app) until a custom domain is set.
CORS_ORIGINS=https://wedding-yantra.vercel.app,https://weddingyantra.com,https://www.weddingyantra.com,https://app.weddingyantra.com,http://localhost:3000

# Optional regex for Vercel preview deployments (leave empty to disable)
CORS_VERCEL_PREVIEW_PATTERN=^https://wedding-yantra-[a-z0-9-]+\.vercel\.app$

# Name of the EXISTING Docker network your reverse proxy is attached to.
# Coolify's Traefik uses `coolify`; for NPM/Caddy use the network you created (e.g. web-proxy).
PROXY_NETWORK=coolify

# Public hostname of the API (no https://). No domain yet? Use sslip.io with your VPS IP:
#   api.203-0-113-10.sslip.io   (dots in the IP replaced by dashes)
API_HOST=api.203-0-113-10.sslip.io

# Traefik names (defaults match Coolify; only change if your Traefik differs)
# TRAEFIK_HTTPS_ENTRYPOINT=https
# TRAEFIK_HTTP_ENTRYPOINT=http
# TRAEFIK_CERT_RESOLVER=letsencrypt

# Sign-in codes (OTP). Until an SMS/WhatsApp provider is connected, codes are not delivered.
# `true` returns the code in the API response so you can test the live app yourself.
# Anyone could then sign in as any number: switch it off before real customers use the app.
AUTH_OTP_DEV_ECHO=false

# Bill photos are served through links signed with this key. Optional: by default it is
# derived from the database password. Changing it only makes open links stop working.
# FILES_SECRET=

LOG_LEVEL=info

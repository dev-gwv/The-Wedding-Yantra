# Local development (`pnpm db:up` starts Postgres on 127.0.0.1:5433)
PORT=4000
DATABASE_URL=postgres://wedding_yantra:wedding_yantra@127.0.0.1:5433/wedding_yantra
CORS_ORIGINS=http://localhost:3000
# Show sign-in codes on screen while there is no SMS/WhatsApp provider (development only)
AUTH_OTP_DEV_ECHO=true
LOG_LEVEL=debug
# Facebook & Instagram lead ads with a pretend Facebook (no Meta app needed). Real keys: see
# the root .env.example and docs/DEPLOYMENT.md.
# META_FAKE=true
# WEB_APP_URL=http://localhost:3000
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_TOKEN_KEY=
# META_LOGIN_CONFIG_ID=
# META_GRAPH_VERSION=v26.0
# META_POLL_MINUTES=30
# META_ENABLED_FOR=all
# Fixed sign-in code for Meta's app reviewer (all three or none; UNTIL must be in the future)
# AUTH_REVIEW_PHONE=
# AUTH_REVIEW_CODE=
# AUTH_REVIEW_UNTIL=

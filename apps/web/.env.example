# Public base URL of the API (no trailing slash). Inlined at build time.
# Local:      http://localhost:4000
# Production: https://api.weddingyantra.com   (set in Vercel -> Project -> Settings -> Environment Variables)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: the "Connect Facebook & Instagram" tutorial video, in the corner of Leads and at the
# top of the guide. Empty: the built-in tutorial (public/videos/connect-facebook.mp4). A YouTube
# link or a direct .mp4/.webm link (e.g. an AI presenter video) replaces it.
NEXT_PUBLIC_FACEBOOK_GUIDE_VIDEO_URL=
